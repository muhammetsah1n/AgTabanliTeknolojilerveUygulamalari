@model KayitViewModel
@{
    ViewData["Title"] = "Kayıt Ol";
}

<section class="form-bolumu">
    <div class="form-kart">
        <div class="form-ikon"><i class="bi bi-person-plus"></i></div>
        <h1 class="form-baslik">Kayıt Ol</h1>
        <p class="form-alt">Birkaç saniyede hesabını oluştur.</p>

        <form asp-action="Kayit" method="post" class="form-alanlar" novalidate>
            <div asp-validation-summary="ModelOnly" class="form-uyari" role="alert"></div>

            <div class="alan">
                <label asp-for="AdSoyad"></label>
                <input asp-for="AdSoyad" class="girdi" autocomplete="name" />
                <span asp-validation-for="AdSoyad" role="alert"></span>
            </div>

            <div class="alan">
                <label asp-for="Email"></label>
                <input asp-for="Email" class="girdi" autocomplete="email" />
                <span asp-validation-for="Email" role="alert"></span>
            </div>

            <div class="ikili">
                <div class="alan">
                    <label asp-for="Sifre"></label>
                    <input asp-for="Sifre" class="girdi" autocomplete="new-password" />
                    <span asp-validation-for="Sifre" role="alert"></span>
                </div>
                <div class="alan">
                    <label asp-for="SifreTekrar"></label>
                    <input asp-for="SifreTekrar" class="girdi" autocomplete="new-password" />
                    <span asp-validation-for="SifreTekrar" role="alert"></span>
                </div>
            </div>

            <button type="submit" class="btn btn-ana btn-blok mt-2">Hesap Oluştur</button>
        </form>

        <p class="form-alt-link">Zaten hesabın var mı? <a asp-action="Giris">Giriş yap</a></p>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
