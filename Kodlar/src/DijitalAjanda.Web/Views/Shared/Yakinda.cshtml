@model YakindaViewModel
@{
    ViewData["Title"] = Model.Baslik;
}

<section class="container py-5">
    <div class="yakinda-kart mx-auto">
        <div class="yakinda-ikon"><i class="bi @Model.Ikon"></i></div>
        <span class="etiket">@Model.PlanlananHafta. haftada geliştirilecek</span>
        <h1 class="sayfa-baslik mt-3">@Model.Baslik</h1>
        <p class="text-secondary-emphasis mb-4">@Model.Aciklama</p>

        <h2 class="h6 text-uppercase kucuk-baslik">Bu sayfada neler olacak?</h2>
        <ul class="ozellik-listesi">
            @foreach (var ozellik in Model.Ozellikler)
            {
                <li><i class="bi bi-check2-circle"></i>@ozellik</li>
            }
        </ul>

        <a class="btn btn-cizgili mt-3" asp-controller="Home" asp-action="Index">
            <i class="bi bi-arrow-left me-1"></i>Ana sayfaya dön
        </a>
    </div>
</section>
