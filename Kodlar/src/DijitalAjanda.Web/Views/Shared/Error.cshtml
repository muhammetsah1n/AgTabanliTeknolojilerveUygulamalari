@model ErrorViewModel
@{
    ViewData["Title"] = Model.BulunamadiMi ? "Sayfa bulunamadı" : "Hata";
}

<section class="durum-bolumu">
    <div class="durum-kart">
        <div class="form-ikon">
            <i class="bi @(Model.BulunamadiMi ? "bi-signpost-split" : "bi-exclamation-triangle")"></i>
        </div>
        @if (Model.BulunamadiMi)
        {
            <h1 class="form-baslik">Sayfa bulunamadı</h1>
            <p>Aradığın sayfa taşınmış ya da hiç var olmamış olabilir.</p>
        }
        else
        {
            <h1 class="form-baslik">Bir hata oluştu</h1>
            <p>İsteğin işlenirken beklenmeyen bir sorun çıktı. Lütfen daha sonra tekrar dene.</p>
            @if (Model.ShowRequestId)
            {
                <p class="istek-kimligi">İstek kimliği: <code>@Model.RequestId</code></p>
            }
        }
        <a class="btn btn-ana" asp-controller="Home" asp-action="Index">Ana sayfaya dön</a>
    </div>
</section>
