@model List<OzellikKarti>
@{
    ViewData["Title"] = "Ana Sayfa";

    var girisYapti = User.Identity?.IsAuthenticated == true;
    var adminMi = User.IsInRole(Roller.Admin);

    var ornekMaddeler = new[]
    {
        (Isaret: "○", Metin: "09:30 Ekip toplantısı", Bitti: false),
        (Isaret: "×", Metin: "Fatura öde", Bitti: true),
        (Isaret: "•", Metin: "Rapor taslağını bitir", Bitti: false),
        (Isaret: "•", Metin: "2 litre su iç", Bitti: false),
        (Isaret: "×", Metin: "20 sayfa kitap oku", Bitti: true)
    };
}

<section class="giris-bolumu">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-12 col-lg-6">
                <span class="etiket">Kâğıt ajandanın sadeliği, dijitalin esnekliği</span>
                <h1 class="giris-baslik el">Günün, haftan ve hedeflerin tek bir defterde.</h1>
                <p class="giris-metin">
                    Bullet journal tadında bir dijital ajanda: yapılacaklarını • ile yaz, bitirince × ile işaretle.
                    Görevler, notlar, su takibi ve kitaplığın aynı yerde; bilgisayardan, tabletten ya da telefondan ulaş.
                </p>
                <div class="d-flex flex-wrap gap-2 mt-4">
                    @if (adminMi)
                    {
                        <a class="btn btn-ana btn-lg" asp-controller="Yonetim" asp-action="Index">Yönetim paneline git</a>
                    }
                    else if (girisYapti)
                    {
                        <a class="btn btn-ana btn-lg" asp-controller="Bugun" asp-action="Index">Defterini aç</a>
                    }
                    else
                    {
                        <a class="btn btn-ana btn-lg" asp-controller="Hesap" asp-action="Kayit">Defterini oluştur</a>
                        <a class="btn btn-cizgili btn-lg" asp-controller="Hesap" asp-action="Giris">Giriş yap</a>
                    }
                </div>
            </div>

            <div class="col-12 col-lg-6">
                <div class="defter defter-onizleme" aria-label="Bugün sayfası önizlemesi">
                    <span class="bant" aria-hidden="true"></span>
                    <h2 class="el">Salı, 20 Ekim</h2>
                    <ul class="madde-listesi">
                        @foreach (var madde in ornekMaddeler)
                        {
                            <li>
                                <span class="isaret" aria-hidden="true">@madde.Isaret</span>
                                <span class="@(madde.Bitti ? "bitti" : "")">@madde.Metin</span>
                            </li>
                        }
                    </ul>
                    <p class="isaret-aciklama">• yapılacak &nbsp; × bitti &nbsp; ○ etkinlik</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="container py-5">
    <div class="text-center mb-5">
        <h2 class="bolum-baslik el mb-1">Dört bölüm, tek defter</h2>
        <p class="text-secondary">Her bölüm ayrı çalışır, hepsi aynı ajandada birleşir.</p>
    </div>
    <div class="row g-4">
        @foreach (var kart in Model)
        {
            <div class="col-12 col-sm-6 col-lg-3">
                <div class="ozellik-kart h-100 @kart.RenkSinifi">
                    <div class="ozellik-ikon"><i class="bi @kart.Ikon"></i></div>
                    <h3>@kart.Baslik</h3>
                    <p>@kart.Aciklama</p>
                </div>
            </div>
        }
    </div>
</section>

<section class="container pb-5">
    <div class="adim-bandi">
        <div class="row g-4 text-center text-md-start">
            <div class="col-12 col-md-4">
                <span class="adim-no">1</span>
                <h3>Defterini oluştur</h3>
                <p>Birkaç saniyede kayıt ol; kendi kategorilerini belirle.</p>
            </div>
            <div class="col-12 col-md-4">
                <span class="adim-no">2</span>
                <h3>Gününü yaz</h3>
                <p>Bugün sayfasına maddelerini ekle, haftanı ve ayını planla.</p>
            </div>
            <div class="col-12 col-md-4">
                <span class="adim-no">3</span>
                <h3>Gelişimini izle</h3>
                <p>Alışkanlık serilerini, su hedefini ve kitaplığını takip et.</p>
            </div>
        </div>
    </div>
</section>
